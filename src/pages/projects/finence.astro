---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import ProjectPage from "../../components/Projects/ProjectPage.astro";
import Gallery from "../../components/Projects/Gallery.astro";
import FeaturesCard from "../../components/Projects/FeaturesCard.astro";

const myImages = [
  { src: "/img/projects/finence/1.webp", alt: "Primera captura" },
  { src: "/img/projects/finence/2.webp", alt: "Segunda captura" },
  { src: "/img/projects/finence/3.webp", alt: "Tercera captura" },
  { src: "/img/projects/finence/4.webp", alt: "Cuarta captura" }
]
---

<Layout
  title="Finence — Control de finanzas personales | Guille Bouix"
  description="Registro de ingresos y gastos, historial de transacciones y balances visuales en tiempo real. Proyecto para profundizar React, Supabase y manejo de estado."
>
  <header>
    <Navbar />
  </header>
  
  <main id="content">
    <ProjectPage
      title="Finence"
      subtitle="Control de finanzas personales"
      categories={["Full-Stack"]}
      banner="/img/projects/finence.webp"
      description="Registro de ingresos y gastos, historial de transacciones y visualización de balances mediante gráficos interactivos en tiempo real. Desarrollado para trabajar en profundidad Supabase, PostgreSQL, autenticación y manejo de estado con React y Zustand."
      githubUrl="https://github.com/GuilleBouix/Finence"
      tech={["React", "Vite", "TypeScript", "Zustand", "Tailwind CSS", "Supabase"]}
    >

      <!-- Gallery -->
      <div slot="gallery">
        <Gallery images={myImages} />
      </div>

      <!-- Features -->
      <ul slot="features" class="list-disc list-inside space-y-3 mt-2">
        <FeaturesCard title="Registro de transacciones" description="Permite agregar, editar y eliminar ingresos y gastos." />
        <FeaturesCard title="Resumen financiero" description="Total de ingresos, gastos y balance general actualizado al instante." />
        <FeaturesCard title="Historial detallado" description="Lista organizada con fechas, montos y categoría." />
        <FeaturesCard title="Gráficos y estadísticas" description="Visualizaciones interactivas con Recharts." />
        <FeaturesCard title="Autenticación segura" description="Login protegido con Supabase Auth." />
      </ul>

    </ProjectPage>
  </main>
  
  <Footer />
</Layout>
