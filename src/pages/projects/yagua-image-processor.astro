---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectPage from "../../components/Projects/ProjectPage.astro";
import Gallery from "../../components/Projects/Gallery.astro";
import FeaturesCard from "../../components/Projects/FeaturesCard.astro";

import banner from "../../assets/projects/yagua.webp";
import img1 from "../../assets/projects/yagua/1.webp";
import img2 from "../../assets/projects/yagua/2.webp";
import img3 from "../../assets/projects/yagua/3.webp";
import img4 from "../../assets/projects/yagua/4.webp";
import img5 from "../../assets/projects/yagua/5.webp";
import img6 from "../../assets/projects/yagua/6.webp";
import img7 from "../../assets/projects/yagua/7.webp";
import img8 from "../../assets/projects/yagua/8.webp";
import img9 from "../../assets/projects/yagua/9.webp";
import img10 from "../../assets/projects/yagua/10.webp";
import img11 from "../../assets/projects/yagua/11.webp";
import img12 from "../../assets/projects/yagua/12.webp";

const myImages = [
  { src: img1, alt: "Pantalla de inicio de Yagua con sus herramientas disponibles" },
  { src: img2, alt: "Herramienta Convert con archivos cargados y opciones de formato" },
  { src: img3, alt: "Herramienta Compress con ajuste de calidad" },
  { src: img4, alt: "Herramienta Resize con opciones para cambiar tamaño y recortar" },
  { src: img5, alt: "Herramienta Remove Background" },
  { src: img6, alt: "Herramienta Color Palette con colores extraídos de una imagen" },
  { src: img7, alt: "Herramienta Watermark con vista previa de marca de agua" },
  { src: img8, alt: "Herramienta Batch Rename con vista previa de nombres" },
  { src: img9, alt: "Herramienta Extract Text con resultado OCR" },
  { src: img10, alt: "Herramienta EXIF Metadata con información de una imagen" },
  { src: img11, alt: "Herramienta LQIP y Base64 con vista previa de resultado" },
  { src: img12, alt: "Configuración de idioma, tema, escala y módulos visibles" }
]
---

<Layout
  title="Yagua Image Processor — App open source para imágenes | Guille Bouix"
  description="App de escritorio open source para procesar imágenes en lote: compresión, conversión, eliminación de fondo con IA y extracción de paletas."
>
  <header>
    <Navbar />
  </header>

  <main id="content">
    <ProjectPage
      title="Yagua Image Processor"
      subtitle="Software open-source de procesamiento de imágenes"
      categories={["Desktop App", "Open Source"]}
      banner={banner}
      description="Aplicación de escritorio gratuita y de código abierto para convertir, comprimir y procesar imágenes por lotes. Incluye herramientas para redimensionar, recortar, eliminar fondos con IA, extraer texto con OCR y gestionar metadatos. Los archivos se procesan en tu equipo; OCR y Quitar Fondo requieren descargar sus modelos antes del primer uso y los límites por lote varían según la herramienta."
      githubUrl="https://github.com/GuilleBouix/Yagua-Image-Processor"
      siteUrl="https://yagua.app/es/"
      tech={["Python · CustomTkinter", "Pillow · Pillow-HEIF", "rembg · ONNX Runtime", "EasyOCR · PyTorch", "piexif", "PyInstaller · Inno Setup · AppImage"]}
    >

      <!-- Gallery -->
      <div slot="gallery">
        <Gallery images={myImages} />
      </div>

      <!-- Funcionalidades -->
      <ul slot="features" class="list-disc list-inside space-y-3 mt-2">
        <FeaturesCard title="Compresión de imágenes" description="Reduce el peso de una imagen sin cambiar su formato; el resultado depende del archivo y la calidad seleccionada." />
        <FeaturesCard title="Conversión de formatos" description="Convierte imágenes entre los formatos disponibles según el módulo, los códecs instalados y la plataforma." />
        <FeaturesCard title="Eliminación de fondo con IA" description="Usa rembg de forma local. El modelo se descarga al usar esta herramienta por primera vez; después puede funcionar sin conexión si está guardado en caché." />
        <FeaturesCard title="Redimensionado, recorte y canvas" description="Cambia las dimensiones, recorta una imagen o añade espacio alrededor." />
        <FeaturesCard title="Extracción de paleta de colores" description="Extrae colores de una imagen y copia sus valores HEX, RGB o HSL." />
        <FeaturesCard title="Renombrado por lotes" description="Previsualiza cambios de nombres con numeración, fecha y opciones de mayúsculas o minúsculas." />
        <FeaturesCard title="Metadatos EXIF" description="Consulta y exporta metadatos, edita algunos campos o limpia datos en lote." />
        <FeaturesCard title="OCR para extraer texto" description="Reconoce texto en español o inglés; permite copiarlo o exportarlo como TXT. Admite hasta 10 imágenes por lote." />
        <FeaturesCard title="LQIP y Base64" description="Genera placeholders de baja calidad o codifica imágenes para usarlas en la web." />
        <FeaturesCard title="Interfaz configurable" description="El código actual incluye nueve idiomas de interfaz, tema oscuro y escala ajustable. Los idiomas disponibles pueden variar según la versión instalada." />
      </ul>

    </ProjectPage>
  </main>
  <Footer />
</Layout>
