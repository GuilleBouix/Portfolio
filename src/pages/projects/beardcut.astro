---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import ProjectPage from "../../components/Projects/ProjectPage.astro";
import Gallery from "../../components/Projects/Gallery.astro";
import FeaturesCard from "../../components/Projects/FeaturesCard.astro";

import banner from "../../assets/projects/beardcut.webp";
import img1 from "../../assets/projects/beardcut/1.webp";
import img2 from "../../assets/projects/beardcut/2.webp";
import img3 from "../../assets/projects/beardcut/3.webp";
import img4 from "../../assets/projects/beardcut/4.webp";
import img5 from "../../assets/projects/beardcut/5.webp";
import img6 from "../../assets/projects/beardcut/6.webp";
import img7 from "../../assets/projects/beardcut/7.webp";
import img8 from "../../assets/projects/beardcut/8.webp";

const myImages = [
  { src: img1, alt: "Primera captura" },
  { src: img2, alt: "Segunda captura" },
  { src: img3, alt: "Tercera captura" },
  { src: img4, alt: "Cuarta captura" },
  { src: img5, alt: "Quinta captura" },
  { src: img6, alt: "Sexta captura" },
  { src: img7, alt: "Séptima captura" },
  { src: img8, alt: "Octava captura" }
]
---

<Layout
  title="BeardCut — Sistema de turnos para barbería | Guille Bouix"
  description="Landing pública con reserva de turnos y panel de administración en Flask para gestionar horarios, reservas y servicios de una barbería."
>
  <header>
    <Navbar />
  </header>
  
  <main id="content">
    <ProjectPage
      title="BeardCut"
      subtitle="Sistema de turnos para barbería"
      categories={["Full-Stack"]}
      banner={banner}
      description="Landing pública con reserva de turnos según disponibilidad configurada por el negocio, más panel de administración en Flask para gestionar, completar o cancelar reservas. Desarrollado sobre el rubro de barbería/peluquería, un sector en crecimiento con demanda real de digitalización de turnos."
      tech={["Astro", "JavaScript", "HTML", "Tailwind CSS", "Python", "Flask", "PostgreSQL"]}
    >

      <!-- Gallery -->
      <div slot="gallery">
        <Gallery images={myImages} />
      </div>

      <!-- Features -->
      <ul slot="features" class="list-disc list-inside space-y-3 mt-2">
        <FeaturesCard title="Turnos y agenda" description="Los visitantes pueden solicitar turnos y el sistema valida la disponibilidad." />
        <FeaturesCard title="Panel de administración" description="Tabla con fecha, horario, estado y acciones para completarlos o eliminarlos." />
        <FeaturesCard title="Horarios de atención" description="Configuración de horarios laborales del negocio." />
        <FeaturesCard title="Gestión de servicios" description="Administración del catálogo con nombre, categoría y precio." />
        <FeaturesCard title="Perfil del negocio" description="Configuración del nombre del local y esquema de horarios." />
      </ul>

    </ProjectPage>
  </main>
  
  <Footer />
</Layout>
