---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectPage from "../../components/Projects/ProjectPage.astro";
import Gallery from "../../components/Projects/Gallery.astro";
import FeaturesCard from "../../components/Projects/FeaturesCard.astro";

import banner from "../../assets/projects/textly-chat.webp";
import img1 from "../../assets/projects/textly-chat/1.webp";
import img2 from "../../assets/projects/textly-chat/2.webp";
import img3 from "../../assets/projects/textly-chat/3.webp";
import img4 from "../../assets/projects/textly-chat/4.webp";
import img5 from "../../assets/projects/textly-chat/5.webp";
import img6 from "../../assets/projects/textly-chat/6.webp";

const myImages = [
  { src: img1, alt: "Captura 1" },
  { src: img2, alt: "Captura 2" },
  { src: img3, alt: "Captura 3" },
  { src: img4, alt: "Captura 4" },
  { src: img5, alt: "Captura 5" },
  { src: img6, alt: "Captura 6" }
]
---

<Layout
  title="Textly Chat — Chat privado con IA | Guille Bouix"
  description="Chat privado en tiempo real con salas privadas e inteligencia artificial para mejorar la redacción, claridad y traducción de mensajes."
>
  <header>
    <Navbar />
  </header>

  <main id="content">
    <ProjectPage
      title="Textly Chat"
      subtitle="Chat privado por salas con asistencia de IA integrada"
      categories={["Full-Stack"]}
      banner={banner}
      description="Salas privadas en tiempo real entre dos usuarios, con traducción instantánea integrada y asistencia de IA para mejorar la redacción de los mensajes. Primera implementación de IA integrada a un producto real, más allá de un chatbot aislado."
      tech={["Next.js", "React", "TypeScript", "Tailwind CSS", "Gemini Flash API"]}
    >

      <!-- Gallery -->
      <div slot="gallery">
        <Gallery images={myImages} />
      </div>

      <!-- Funcionalidades -->
      <ul slot="features" class="list-disc list-inside space-y-3 mt-2">
        <FeaturesCard title="Chat en tiempo real por salas privadas" description="Conversaciones uno a uno entre dos usuarios." />
        <FeaturesCard title="Asistencia de IA para mejorar redacción" description="Reformulación automática para mayor claridad." />
        <FeaturesCard title="Traducción inteligente de mensajes" description="Traducción en tiempo real antes del envío." />
        <FeaturesCard title="Streaming de respuestas" description="Respuestas y asistencia fluida en tiempo real." />
        <FeaturesCard title="UI moderna estilo SaaS" description="Interfaz minimalista y centrada en la experiencia del usuario." />
        <FeaturesCard title="Diseño totalmente responsive" description="Optimizado para desktop y móvil." />
        <FeaturesCard title="Dark theme premium" description="Estética sofisticada con colores oscuros." />
        <FeaturesCard title="Arquitectura modular" description="Escalable y fácil de mantener." />
      </ul>

    </ProjectPage>
  </main>
  <Footer />
</Layout>
