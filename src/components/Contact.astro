<section id="contact">
    <div class="flex flex-col justify-between items-start gap-2 py-5 mx-auto max-w-5xl px-4 sm:px-6 lg:px-40">
        <h2 data-aos="zoom-in" data-aos-duration="800" class="text-title font-bold text-xl">
            Contáctame
        </h2>

        <form action="https://formspree.io/f/mrbnjrkw" method="POST" class="w-full flex flex-col gap-4 mt-2">
            <div data-aos="zoom-in" data-aos-duration="800" class="flex flex-col gap-1">
                <label for="email" class="text-sm font-medium text-white">Correo electrónico</label>
                <p id="email-help" class="text-sm text-white/75">Obligatorio para enviar por correo.</p>
                <input type="email" autocomplete="email" name="email" id="email" aria-describedby="email-help" required
                class="font-jetbrains bg-surface-low border border-paragraph rounded text-sm text-white px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" />
            </div>

            <div data-aos="zoom-in" data-aos-duration="800" class="flex flex-col gap-1">
                <label for="name" class="text-sm font-medium text-white">Nombre <span class="font-normal text-white/75">(opcional)</span></label>
                <input type="text" autocomplete="name" name="name" id="name"
                class="font-jetbrains bg-surface-low border border-paragraph rounded text-sm text-white px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" />
            </div>

            <div data-aos="zoom-in" data-aos-duration="800" class="flex flex-col gap-1">
                <label for="message" class="text-sm font-medium text-white">Mensaje <span aria-hidden="true" class="font-normal text-white/75">(obligatorio)</span></label>
                <textarea name="message" id="message" required class="font-jetbrains bg-surface-low border border-paragraph rounded text-sm text-white px-4 py-3 resize-y min-h-30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-invalid:border-red-300"></textarea>
                <p id="whatsapp-message-error" hidden class="text-sm text-red-300">Escribí un mensaje para continuar.</p>
            </div>

            <div data-aos="zoom-in" data-aos-duration="800" class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <button type="submit" class="font-jetbrains w-full min-h-12 px-4 py-3 text-sm text-black bg-white border border-white cursor-pointer transition hover:bg-white/80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                    Enviar por correo
                </button>
                <a id="contact-whatsapp" href="https://wa.me/5493755653522" target="_blank" rel="noopener noreferrer"
                class="group font-jetbrains inline-flex w-full min-h-12 items-center justify-center gap-2 border border-border bg-interactive px-4 py-3 text-sm text-white transition hover:bg-white hover:text-black hover:border-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                    <img src="/img/icons/whatsapp.svg" alt="" aria-hidden="true" class="size-4 shrink-0 invert group-hover:invert-0" />
                    Abrir WhatsApp
                </a>
            </div>
        </form>
    </div>
</section>

<script>
    const whatsappLink = document.querySelector<HTMLAnchorElement>('#contact-whatsapp');
    const messageInput = document.querySelector<HTMLTextAreaElement>('#contact #message');
    const nameInput = document.querySelector<HTMLInputElement>('#contact #name');
    const messageError = document.getElementById('whatsapp-message-error');

    if (whatsappLink && messageInput && messageError) {
        const updateWhatsAppLink = () => {
            const name = nameInput?.value.trim();
            const message = messageInput.value.trim();
            const text = name ? `Hola Guille, soy ${name}.\n\n${message}` : message;
            whatsappLink.href = `https://wa.me/5493755653522?text=${encodeURIComponent(text)}`;
        };

        messageInput.addEventListener('input', () => {
            if (messageInput.value.trim()) {
                messageInput.setCustomValidity('');
                messageInput.removeAttribute('aria-invalid');
                messageInput.removeAttribute('aria-describedby');
                messageError.hidden = true;
            }
            updateWhatsAppLink();
        });
        nameInput?.addEventListener('input', updateWhatsAppLink);

        whatsappLink.addEventListener('click', (event) => {
            if (!messageInput.value.trim()) {
                event.preventDefault();
                messageError.hidden = false;
                messageInput.setCustomValidity(messageError.textContent?.trim() ?? '');
                messageInput.setAttribute('aria-invalid', 'true');
                messageInput.setAttribute('aria-describedby', messageError.id);
                messageInput.focus();
                return;
            }

            updateWhatsAppLink();
        });
    }
</script>
