---
import { getImage } from 'astro:assets';
import logoSrc from '../assets/logo.webp';

const logo = await getImage({ src: logoSrc, height: 64 });
---

<style>
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--color-title);
    outline-offset: 2px;
  }

  .icon-close,
  details[open] .icon-burger {
    display: none;
  }

  details[open] .icon-close {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .menu-item {
      animation: menu-enter 0.2s ease-out backwards;
    }

    .menu-item:nth-child(2) { animation-delay: 50ms; }
    .menu-item:nth-child(3) { animation-delay: 100ms; }
    .menu-item:nth-child(4) { animation-delay: 150ms; }
    .menu-item:nth-child(5) { animation-delay: 200ms; }

    @keyframes menu-enter {
      from {
        opacity: 0.65;
        transform: translateY(-4px);
      }
    }
  }
</style>

<nav class="relative font-inter">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-40">
    <div class="relative flex h-16 items-center justify-between border-b border-border">

      <!-- Logo -->
      <div class="absolute inset-y-0 left-0 flex items-center sm:static">
        <a href="/" class="group relative block h-8 w-auto overflow-visible" aria-label="Inicio">
          <img
            src={logo.src}
            width={logo.attributes.width}
            height={logo.attributes.height}
            alt="BouixDev Logo"
            class="h-8 w-auto block relative z-10"
          />

          <img
            src={logo.src}
            alt=""
            aria-hidden="true"
            class="absolute top-0 left-0.5 h-8 w-auto opacity-0
                  motion-safe:group-hover:opacity-100 motion-safe:group-hover:animate-glitch-1
                  drop-shadow-[-1px_0_#d1d5db] brightness-125 z-0"
          />

          <img
            src={logo.src}
            alt=""
            aria-hidden="true"
            class="absolute top-0 -left-0.5 h-8 w-auto opacity-0
                  motion-safe:group-hover:opacity-100 motion-safe:group-hover:animate-glitch-2
                  drop-shadow-[1px_0_#4b5563] contrast-150 z-0"
          />
        </a>
      </div>

      <!-- Enlaces rápidos -->
      <div class="flex flex-1 items-center justify-end">

        <!-- Enlaces Desktop -->
        <div class="hidden sm:block">
          <div class="flex space-x-4 font-jetbrains text-white/75">
            <a rel="noopener noreferrer" data-aos="fade-in" data-aos-duration="400" href="/#about" class="rounded-md px-3 py-2 text-sm font-medium hover:text-white transition-colors">
                Sobre Mí
            </a>

            <a rel="noopener noreferrer" data-aos="fade-in" data-aos-duration="400" data-aos-delay="50" href="/#projects" class="rounded-md px-3 py-2 text-sm font-medium hover:text-white transition-colors">
                Proyectos
            </a>

            <a rel="noopener noreferrer" data-aos="fade-in" data-aos-duration="400" data-aos-delay="100" href="/#education" class="rounded-md px-3 py-2 text-sm font-medium hover:text-white transition-colors">
                Formación
            </a>

            <a rel="noopener noreferrer" data-aos="fade-in" data-aos-duration="400" data-aos-delay="150" href="/#skills" class="rounded-md px-3 py-2 text-sm font-medium hover:text-white transition-colors">
                Habilidades
            </a>

            <a rel="noopener noreferrer" data-aos="fade-in" data-aos-duration="400" data-aos-delay="200" href="/#contact" class="rounded-md px-3 py-2 text-sm font-medium hover:text-white transition-colors">
                Contacto
            </a>
          </div>
        </div>

      </div>
    </div>

    <details id="mobile-navigation" class="sm:hidden">
      <summary class="absolute right-4 top-2 inline-flex list-none cursor-pointer items-center justify-center p-2 text-gray-300 hover:text-white [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menú de navegación</span>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="icon-burger size-8">
          <path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
        </svg>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="icon-close size-8">
          <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </summary>

      <div class="mt-2 space-y-1 border border-border bg-surface px-2 py-3">
        <a rel="noopener noreferrer" href="/#about" class="menu-item block rounded-md px-3 py-2 text-base font-jetbrains font-medium text-gray-300 hover:text-white hover:bg-interactive transition-colors">Sobre Mí</a>
        <a rel="noopener noreferrer" href="/#projects" class="menu-item block rounded-md px-3 py-2 text-base font-jetbrains font-medium text-gray-300 hover:text-white hover:bg-interactive transition-colors">Proyectos</a>
        <a rel="noopener noreferrer" href="/#education" class="menu-item block rounded-md px-3 py-2 text-base font-jetbrains font-medium text-gray-300 hover:text-white hover:bg-interactive transition-colors">Formación</a>
        <a rel="noopener noreferrer" href="/#skills" class="menu-item block rounded-md px-3 py-2 text-base font-jetbrains font-medium text-gray-300 hover:text-white hover:bg-interactive transition-colors">Habilidades</a>
        <a rel="noopener noreferrer" href="/#contact" class="menu-item block rounded-md px-3 py-2 text-base font-jetbrains font-medium text-gray-300 hover:text-white hover:bg-interactive transition-colors">Contacto</a>
      </div>
    </details>
  </div>
</nav>

<script>
  import '../scripts/navbar.ts';
</script>
